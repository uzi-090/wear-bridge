<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb post sample notifications (fake content) to test pop-up styles. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- DUMP is held by the adb shell, not by other apps, so nothing else can trigger this. -->
        <receiver
            android:name=".debug.SampleNotificationReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.wearbridge.watch.debug.SAMPLE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
